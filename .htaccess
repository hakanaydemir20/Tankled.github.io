# tankled.com.tr - Apache/LiteSpeed ayarlari
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # https ve www'suz tek adres (SEO: kopya icerik olmasin)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://tankled.com.tr%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType model/gltf-binary .glb
  AddType application/manifest+json .webmanifest
</IfModule>

# Sikistirma
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml model/gltf-binary
</IfModule>

# Onbellek: gorseller/modeller 30 gun, css/js 7 gun, html her seferinde kontrol
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType model/gltf-binary "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Gizli/kaynak klasorler sunucuya yuklenmez; yine de erisimi kapat
RedirectMatch 404 ^/(_kaynak|_seo|\.git)
